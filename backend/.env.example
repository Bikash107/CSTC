# Copy this file to .env and fill in your values
# cp .env.example .env  (Mac/Linux)
# copy .env.example .env  (Windows)

# Server port
PORT=3000

# MongoDB connection string
# Local:  mongodb://localhost:27017/cstc_db
# Atlas:  mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/cstc_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/cstc_db

# JWT secret — change this to any long random string in production
JWT_SECRET=your_secret_key_here
